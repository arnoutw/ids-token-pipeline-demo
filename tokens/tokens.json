{
  "global": {},
  "Core/Brand A": {
    "font": {
      "family": {
        "ui": {
          "$extensions": {"com.figma.codeSyntax": {"Web": "var(--font-family-ui)"}},
          "$type": "fontFamily", "$value": "Montserrat"
        }
      }
    },
    "brand": {
      "50": {
        "$extensions": {
          "com.figma.scopes": [
            "ALL_FILLS"
          ],
          "com.figma.codeSyntax": {
            "Web": "var(--brand-50)"
          }
        },
        "$type": "color",
        "$value": "#efe8f0"
      },
      "500": {
        "$extensions": {
          "com.figma.scopes": [
            "ALL_FILLS"
          ],
          "com.figma.codeSyntax": {
            "Web": "var(--brand-500)"
          }
        },
        "$type": "color",
        "$value": "#5d176a"
      },
      "600": {
        "$extensions": {
          "com.figma.scopes": [
            "ALL_FILLS"
          ],
          "com.figma.codeSyntax": {
            "Web": "var(--brand-600)"
          }
        },
        "$type": "color",
        "$value": "#551560"
      },
      "700": {
        "$extensions": {
          "com.figma.scopes": [
            "ALL_FILLS"
          ],
          "com.figma.codeSyntax": {
            "Web": "var(--brand-700)"
          }
        },
        "$type": "color",
        "$value": "#42104b"
      },
      "800": {
        "$extensions": {
          "com.figma.scopes": [
            "ALL_FILLS"
          ],
          "com.figma.codeSyntax": {
            "Web": "var(--brand-800)"
          }
        },
        "$type": "color",
        "$value": "#330d3a"
      }
    },
    "dynamic-darken": {
      "200": {
        "$extensions": {
          "com.figma.scopes": [
            "ALL_FILLS"
          ],
          "com.figma.codeSyntax": {
            "Web": "var(--dynamic-darken-200)"
          }
        },
        "$type": "color",
        "$value": "#00000026"
      }
    },
    "focus": {
      "ring": {
        "$extensions": {"com.figma.codeSyntax": {"Web": "var(--focus-ring)"}},
        "$type": "color",
        "$value": "#252231"
      }
    },
    "radius": {
      "control": {
        "$extensions": {
          "com.figma.scopes": [
            "CORNER_RADIUS"
          ],
          "com.figma.codeSyntax": {
            "Web": "var(--radius-control)"
          }
        },
        "$type": "dimension",
        "$value": "4px"
      }
    }
  },
  "Core/Brand B": {
    "font": {
      "family": {
        "ui": {
          "$extensions": {"com.figma.codeSyntax": {"Web": "var(--font-family-ui)"}},
          "$type": "fontFamily", "$value": "Source Sans 3"
        }
      }
    },
    "brand": {
      "50": {
        "$extensions": {"com.figma.scopes": ["ALL_FILLS"], "com.figma.codeSyntax": {"Web": "var(--brand-50)"}},
        "$type": "color", "$value": "#e6fffb"
      },
      "500": {
        "$extensions": {"com.figma.scopes": ["ALL_FILLS"], "com.figma.codeSyntax": {"Web": "var(--brand-500)"}},
        "$type": "color", "$value": "#126a60"
      },
      "600": {
        "$extensions": {"com.figma.scopes": ["ALL_FILLS"], "com.figma.codeSyntax": {"Web": "var(--brand-600)"}},
        "$type": "color", "$value": "#105d54"
      },
      "700": {
        "$extensions": {"com.figma.scopes": ["ALL_FILLS"], "com.figma.codeSyntax": {"Web": "var(--brand-700)"}},
        "$type": "color", "$value": "#0b524a"
      },
      "800": {
        "$extensions": {"com.figma.scopes": ["ALL_FILLS"], "com.figma.codeSyntax": {"Web": "var(--brand-800)"}},
        "$type": "color", "$value": "#083f3a"
      }
    },
    "dynamic-darken": {
      "200": {
        "$extensions": {"com.figma.scopes": ["ALL_FILLS"], "com.figma.codeSyntax": {"Web": "var(--dynamic-darken-200)"}},
        "$type": "color", "$value": "#00000026"
      }
    },
    "focus": {
      "ring": {
        "$extensions": {"com.figma.codeSyntax": {"Web": "var(--focus-ring)"}},
        "$type": "color", "$value": "#252231"
      }
    },
    "radius": {
      "control": {
        "$extensions": {"com.figma.scopes": ["CORNER_RADIUS"], "com.figma.codeSyntax": {"Web": "var(--radius-control)"}},
        "$type": "dimension", "$value": "4px"
      }
    }
  },
  "Semantic/Value": {
    "typography": {
      "control": {
        "font-family": {
          "$extensions": {"com.figma.scopes": ["FONT_FAMILY"], "com.figma.codeSyntax": {"Web": "var(--typography-control-font-family)"}},
          "$type": "fontFamily", "$value": "{font.family.ui}"
        }
      }
    },
    "button": {
      "primary": {
        "background": {
          "default": {
            "$extensions": {"com.figma.scopes": ["FRAME_FILL"], "com.figma.codeSyntax": {"Web": "var(--button-primary-background-default)"}},
            "$type": "color", "$value": "{brand.500}"
          },
          "hover": {
            "$extensions": {"com.figma.scopes": ["FRAME_FILL"], "com.figma.codeSyntax": {"Web": "var(--button-primary-background-hover)"}},
            "$type": "color", "$value": "{brand.700}"
          },
          "focus": {
            "$extensions": {"com.figma.scopes": ["FRAME_FILL"], "com.figma.codeSyntax": {"Web": "var(--button-primary-background-focus)"}},
            "$type": "color", "$value": "{brand.600}"
          },
          "pressed": {
            "$extensions": {"com.figma.scopes": ["FRAME_FILL"], "com.figma.codeSyntax": {"Web": "var(--button-primary-background-pressed)"}},
            "$type": "color", "$value": "{brand.800}"
          }
        },
        "text": {
          "$extensions": {"com.figma.scopes": ["TEXT_FILL"], "com.figma.codeSyntax": {"Web": "var(--button-primary-text)"}},
          "$type": "color", "$value": "{brand.50}"
        },
        "focus-ring": {
          "$extensions": {"com.figma.scopes": ["STROKE_COLOR"], "com.figma.codeSyntax": {"Web": "var(--button-primary-focus-ring)"}},
          "$type": "color", "$value": "{focus.ring}"
        }
      }
    }
  },
  "Platform/Web": {
    "space": {
      "control": {
        "inline": {"$extensions": {"com.figma.scopes": ["GAP"], "com.figma.codeSyntax": {"Web": "var(--space-control-inline)"}}, "$type": "dimension", "$value": "16px"},
        "block": {"$extensions": {"com.figma.scopes": ["GAP"], "com.figma.codeSyntax": {"Web": "var(--space-control-block)"}}, "$type": "dimension", "$value": "12px"}
      }
    },
    "size": {
      "control": {
        "min-width": {"$extensions": {"com.figma.scopes": ["WIDTH_HEIGHT"], "com.figma.codeSyntax": {"Web": "var(--size-control-min-width)"}}, "$type": "dimension", "$value": "75px"},
        "min-height": {"$extensions": {"com.figma.scopes": ["WIDTH_HEIGHT"], "com.figma.codeSyntax": {"Web": "var(--size-control-min-height)"}}, "$type": "dimension", "$value": "48px"}
      }
    },
    "typography": {
      "control": {
        "font-size": {"$extensions": {"com.figma.scopes": ["FONT_SIZE"], "com.figma.codeSyntax": {"Web": "var(--typography-control-font-size)"}}, "$type": "dimension", "$value": "15px"},
        "line-height": {"$extensions": {"com.figma.scopes": ["LINE_HEIGHT"], "com.figma.codeSyntax": {"Web": "var(--typography-control-line-height)"}}, "$type": "dimension", "$value": "24px"}
      }
    },
    "focus": {
      "control": {
        "ring-width": {"$extensions": {"com.figma.scopes": ["STROKE_FLOAT"], "com.figma.codeSyntax": {"Web": "var(--focus-control-ring-width)"}}, "$type": "dimension", "$value": "3px"}
      }
    }
  },
  "Platform/Kiosk": {
    "space": {
      "control": {
        "inline": {"$extensions": {"com.figma.scopes": ["GAP"], "com.figma.codeSyntax": {"Web": "var(--space-control-inline)"}}, "$type": "dimension", "$value": "24px"},
        "block": {"$extensions": {"com.figma.scopes": ["GAP"], "com.figma.codeSyntax": {"Web": "var(--space-control-block)"}}, "$type": "dimension", "$value": "18px"}
      }
    },
    "size": {
      "control": {
        "min-width": {"$extensions": {"com.figma.scopes": ["WIDTH_HEIGHT"], "com.figma.codeSyntax": {"Web": "var(--size-control-min-width)"}}, "$type": "dimension", "$value": "96px"},
        "min-height": {"$extensions": {"com.figma.scopes": ["WIDTH_HEIGHT"], "com.figma.codeSyntax": {"Web": "var(--size-control-min-height)"}}, "$type": "dimension", "$value": "64px"}
      }
    },
    "typography": {
      "control": {
        "font-size": {"$extensions": {"com.figma.scopes": ["FONT_SIZE"], "com.figma.codeSyntax": {"Web": "var(--typography-control-font-size)"}}, "$type": "dimension", "$value": "18px"},
        "line-height": {"$extensions": {"com.figma.scopes": ["LINE_HEIGHT"], "com.figma.codeSyntax": {"Web": "var(--typography-control-line-height)"}}, "$type": "dimension", "$value": "26px"}
      }
    },
    "focus": {
      "control": {
        "ring-width": {"$extensions": {"com.figma.scopes": ["STROKE_FLOAT"], "com.figma.codeSyntax": {"Web": "var(--focus-control-ring-width)"}}, "$type": "dimension", "$value": "3px"}
      }
    }
  },
  "Platform/Onboard": {
    "space": {
      "control": {
        "inline": {"$extensions": {"com.figma.scopes": ["GAP"], "com.figma.codeSyntax": {"Web": "var(--space-control-inline)"}}, "$type": "dimension", "$value": "20px"},
        "block": {"$extensions": {"com.figma.scopes": ["GAP"], "com.figma.codeSyntax": {"Web": "var(--space-control-block)"}}, "$type": "dimension", "$value": "16px"}
      }
    },
    "size": {
      "control": {
        "min-width": {"$extensions": {"com.figma.scopes": ["WIDTH_HEIGHT"], "com.figma.codeSyntax": {"Web": "var(--size-control-min-width)"}}, "$type": "dimension", "$value": "96px"},
        "min-height": {"$extensions": {"com.figma.scopes": ["WIDTH_HEIGHT"], "com.figma.codeSyntax": {"Web": "var(--size-control-min-height)"}}, "$type": "dimension", "$value": "56px"}
      }
    },
    "typography": {
      "control": {
        "font-size": {"$extensions": {"com.figma.scopes": ["FONT_SIZE"], "com.figma.codeSyntax": {"Web": "var(--typography-control-font-size)"}}, "$type": "dimension", "$value": "17px"},
        "line-height": {"$extensions": {"com.figma.scopes": ["LINE_HEIGHT"], "com.figma.codeSyntax": {"Web": "var(--typography-control-line-height)"}}, "$type": "dimension", "$value": "24px"}
      }
    },
    "focus": {
      "control": {
        "ring-width": {"$extensions": {"com.figma.scopes": ["STROKE_FLOAT"], "com.figma.codeSyntax": {"Web": "var(--focus-control-ring-width)"}}, "$type": "dimension", "$value": "5px"}
      }
    }
  },
  "$themes": [],
  "$metadata": {
    "tokenSetOrder": [
      "global",
      "Core/Brand A",
      "Core/Brand B",
      "Semantic/Value",
      "Platform/Web",
      "Platform/Kiosk",
      "Platform/Onboard"
    ]
  }
}
